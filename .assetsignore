# Cloudflare Workers Static Assets — exclude list
# See: https://developers.cloudflare.com/workers/static-assets/binding/#ignore-files
#
# Wrangler treats the repo root as the assets directory, which would
# otherwise include .git/ (the packfile is well over Workers' 25 MiB
# per-asset limit and breaks the deploy). This file excludes infrastructure
# paths while keeping all deployable content (README.md, *.csv, *.png, *.py,
# *.md, acfr_pdf/, budget_pdf/, etc.).
#
# Note: the four source PDFs >25 MiB are NOT listed here — they are already
# kept out of the repo by .gitignore (externalized to R2), so they never
# reach the asset set. Every PDF that remains in the repo is <25 MiB.

# Git internals
.git
.git/**
.gitignore
.gitattributes

# Build artifacts (local-preview only — not for deploy)
dist
dist/**
build.sh
wrangler.jsonc
wrangler.toml

# Editor / OS
.DS_Store
.vscode
.idea
*.swp
*~

# Python
__pycache__
__pycache__/**
*.pyc
*.pyo
.venv
.venv/**
venv
venv/**
